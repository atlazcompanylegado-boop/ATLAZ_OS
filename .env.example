# Copie para .env.local e preencha com valores reais.
# .env.local NUNCA é versionado (ver .gitignore) e NUNCA deve ser sincronizado pelo OneDrive.

# Supabase — projeto do ATLAZ OS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente server-side. Nunca importar em componente client. Nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta do Drizzle (Postgres). Pegue em Supabase > Project Settings > Database.
DATABASE_URL=

# E-mail do usuário que já existe no Supabase Auth e deve virar o primeiro super_admin
# no seed idempotente (src/server/db/seed.ts). Ver docs/seguranca.md.
SUPER_ADMIN_EMAIL=
